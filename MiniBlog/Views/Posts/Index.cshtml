@model IEnumerable<MiniBlog.Models.Post>

@{
    ViewData["Title"] = "Блог";
}

<h1>Мини-блог</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Создать новый пост</a>
</p>

@if (!Model.Any())
{
    <p>Постов пока нет. Будьте первым!</p>
}
else
{
    @foreach (var post in Model)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@post.Title</h5>
                <h6 class="card-subtitle mb-2 text-muted">
                    Автор: @post.Author | Дата: @post.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                </h6>
                <p class="card-text">@(post.Content.Length > 100 ? post.Content.Substring(0, 100) + "..." : post.Content)</p>
                <a asp-action="Details" asp-route-id="@post.Id" class="btn btn-info btn-sm">Подробнее</a>
                <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-warning btn-sm">Редактировать</a>
                <a asp-action="Delete" asp-route-id="@post.Id" class="btn btn-danger btn-sm">Удалить</a>
            </div>
        </div>
    }
}